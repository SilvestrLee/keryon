APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
CENTRAL_DOMAIN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_PRIVATE_DISK=media-private
MEDIA_PUBLIC_DISK=media-public
MEDIA_RENDITION_CLEANUP_GRACE_HOURS=24
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# FaithFlow — see K-FAITHFLOW-001B §20. Non-secret placeholders only; no real
# key belongs in this file. Real credentials are provisioned in a later,
# separately authorized milestone (K-FAITHFLOW-001G).
FAITHFLOW_PROVIDER=anthropic
FAITHFLOW_MODEL=claude-sonnet-5

# AI processor governance. Credentials do not approve production processing.
# Leave under_review/unknown until Product Office records accepted evidence.
AI_ANTHROPIC_APPROVAL_STATUS=under_review
AI_ANTHROPIC_LEGAL_ENTITY=
AI_ANTHROPIC_REGION=unknown
AI_ANTHROPIC_STORAGE_REGION=unknown
AI_ANTHROPIC_RETENTION=unknown
AI_ANTHROPIC_SAFETY_RETENTION=unknown
AI_ANTHROPIC_TRAINING_POLICY=unknown
AI_ANTHROPIC_DELETION_MECHANISM=unknown
AI_ANTHROPIC_CONTRACT_STATUS=unverified
AI_ANTHROPIC_DPA_STATUS=unverified
AI_ANTHROPIC_REVIEWED_AT=
AI_ANTHROPIC_EVIDENCE_REFERENCE=docs/06-Engineering/Anthropic_FaithFlow_Processor_Review.md
AI_ANTHROPIC_ACCOUNT_CONFIGURATION_VERIFIED_AT=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Church staff invitation delivery remains local/test-only until
# K-INVITE-DELIVERY-001. Final legal policy versions are pre-launch inputs.
CHURCH_STAFF_LOCAL_INVITATION_SURFACE=false
# Local/testing use the fixture defaults in config/staff.php when these are
# unset. Staging/production must explicitly provide the governed legal
# policy version identifiers.
# CHURCH_STAFF_TERMS_VERSION=
# CHURCH_STAFF_PRIVACY_VERSION=
